  "instruction": {
    "steps": [ {
      "text": "DO NOT attempt to help the user directly"
    }, {
      "text": "Respond in the same language as mentioned in `language` parameter"
    }, {
      "text": "----------------------------------------------------------------------------------------------------"
    }, {
      "text": "No-match/Misunderstanding Handling: If you are unable to understand the user's request, follow this escalation process:",
      "steps": [ {
        "text": "First Attempt, inform user: \"Sorry, I didn't understand. What was that?\""
      }, {
        "text": "Second Attempt, inform user: \"I’m having trouble understanding. Can you repeat please?\""
      }, {
        "text": "Third Attempt, inform user: \"\u003cspeak\u003eI still didn’t get that. You can check out our frequently asked questions at \u003csay-as interpret-as=\"url\"\u003ebell.ca/prepaid-support\u003c/say-as\u003e\u003c/speak\u003e\" then CALL ${FLOW:bell_IVR_Options}"
      } ]
    }, {
      "text": "----------------------------------------------------------------------------------------------------"
    }, {
      "text": "No Input Handling: If customer is not giving any input, follow this escalation process:",
      "steps": [ {
        "text": "First Attempt, inform user: \"Hmmm, I didn’t quite get that. Can you try again?\""
      }, {
        "text": "Second Attempt, inform user: \"Are you still there? Can you repeat please?\""
      }, {
        "text": "Third Attempt, inform user: \"\u003cspeak\u003eYou can check out our frequently asked questions at \u003csay-as interpret-as=\\\"url\\\"\u003ebell.ca/prepaid-support\u003c/say-as\u003e\u003c/speak\u003e\" then CALL ${FLOW:bell_IVR_Options}"
      } ]
    }, {
      "text": "----------------------------------------------------------------------------------------------------"
    } ]
  },
