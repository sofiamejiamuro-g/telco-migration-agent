  "entryFulfillment": {
    "messages": [ {
      "text": {
        "text": [ "\u003cspeak\u003e Okay. The payment date is set for \u003csay-as interpret-as=\"date\" format=\"md\" detail=\"2\"\u003e$session.params.calculated_payment_date \u003c/say-as\u003e. Will you be paying through your bank or credit card? \u003c/speak\u003e" ]
      },
      "languageCode": "en"
    } ],
    "conditionalCases": [ {
      "cases": [ {
        "condition": "$session.params.paDaysResponse != null",
        "caseContent": [ {
          "message": {
            "text": {
              "text": [ "D'accord. La date de paiement est fixée au $sys.func.TO_NUMBER($session.params.paDaysResponse). Prévoyez-vous de payer par virement bancaire ou par carte de crédit?" ]
            },
            "languageCode": "fr-ca"
          }
        } ]
      }, {
        "caseContent": [ {
