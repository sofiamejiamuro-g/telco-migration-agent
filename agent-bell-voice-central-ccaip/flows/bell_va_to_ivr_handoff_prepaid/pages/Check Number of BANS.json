      "parameter": "n_ban_with_lob",
      "value": "$sys.func.COUNT($session.params.ban_with_lob)"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.NGA = true OR $session.params.NGA = \"true\"",
