    }, {
      "parameter": "_other_services",
      "value": "$sys.func.FILTER(\"$session.params._billing_accounts\", \"$.[*].services[*]\")"
    }, {
      "parameter": "ban_with_lob",
      "value": "$sys.func.FILTER(\"$session.params._other_services\", \"$.[?(@.service_type == '$session.params.lob')]\")"
