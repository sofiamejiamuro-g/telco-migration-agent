{
  "name": "494f23a7-4be0-4d8c-a8dd-2d7865c78efc",
  "displayName": "Regional Webhook",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/customer-identification#search-region-by-tn",
    "tag": "search-region-by-tn",
    "setParameterActions": [ {
      "parameter": "telephone_number",
      "value": "$sys.func.IF(\"$session.params.CIRN = null\", $session.params.clid, $session.params.CIRN)"
    }, {
      "parameter": "webhook_success",
      "value": null
    }, {
      "parameter": "brand",
      "value": "Bell"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = True OR $session.params.webhook_success = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "customer_id_search_response",
        "value": "$sys.func.TO_OBJECT($session.params.customer_id_search_region_response)"
      }, {
        "parameter": "subscriber_number",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].services[0].service_account_number"
      }, {
        "parameter": "billing_account_number_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$..billing_account_number\")"
      }, {
        "parameter": "n_billing_account",
        "value": "$sys.func.COUNT($session.params.billing_account_number_list)"
      }, {
        "parameter": "billing_account_info_list",
        "value": "$sys.func.GET_FIELD($sys.func.GET($sys.func.GET_FIELD($session.params.customer_id_search_response, \"users\"), 0), \"billing_accounts\")"
      }, {
        "parameter": "is_prepaid_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$[*].users[?(@.contact_number == '$session.params.CIRN')].billing_accounts[*].billing_account_number\")"
      }, {
        "parameter": "is_prepaid_list",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].services[0].is_prepaid"
      }, {
        "parameter": "active_services",
        "value": "$sys.func.FILTER(\"$session.params.billing_account_info_list\", \"$[*].services[*].service_type\")"
      }, {
        "parameter": "unique_services",
        "value": "$sys.func.UNIQUE($session.params.active_services)"
      }, {
        "parameter": "contain_mobility",
        "value": "$sys.func.CONTAIN($session.params.unique_services, \"MOBILITY\")"
      }, {
        "parameter": "province",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].billing_address.stateOrProvince"
      }, {
        "parameter": "BBM_flag",
        "value": true
      }, {
        "parameter": "service_id",
        "value": "$session.params.billing_account_info_list[0].services[0].service_id"
      }, {
        "parameter": "brand_value",
        "value": "$sys.func.UNIQUE($sys.func.FILTER(\"$session.params.customer_id_search_region_response\",\"$..services[*].brand\") )"
      }, {
        "parameter": "brand",
        "value": "$sys.func.GET($session.params.brand_value, 0)"
      }, {
        "parameter": "regional_flag",
        "value": true
      } ]
    },
    "name": "8f4d253b-8eeb-4030-bd53-286236d8ec67"
  }, {
    "condition": "$session.params.brand = Atlantic AND $session.params.clid_pass = true AND $session.params.ivr_handoff != true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "region",
        "value": "ATL"
      }, {
        "parameter": "brand",
        "value": "bell aliant"
      } ]
