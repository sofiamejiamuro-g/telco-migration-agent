  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/npa-nxx-lookup",
    "tag": "NA",
    "setParameterActions": [ {
      "parameter": "temp_number",
      "value": "$sys.func.IF(\"$session.params.CIRN = null\", $session.params.clid, $session.params.CIRN)"
    }, {
      "parameter": "npa",
      "value": "$sys.func.MID($session.params.temp_number, 1, 3)"
    }, {
      "parameter": "nxx",
      "value": "$sys.func.MID($session.params.temp_number, 4, 3)"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = \"true\"",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "webhook_success",
        "value": null
      }, {
        "parameter": "province",
        "value": "$session.params.npa_nxx_lookup_response.province"
      }, {
        "parameter": "id_channel",
        "value": "newcx_context_retention"
      }, {
        "parameter": "utterance",
        "value": "$request.user-utterance"
      } ]
    },
    "targetPage": "New Customer Check",
    "name": "49bfe1c5-663b-4b80-a479-69acdc8ba124"
  }, {
    "condition": "$session.params.webhook_success = \"false\"",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "id_channel",
        "value": "newcx_context_retention"
      }, {
        "parameter": "utterance",
        "value": "$request.user-utterance"
      } ]
    },
    "targetPage": "New Customer Check",
