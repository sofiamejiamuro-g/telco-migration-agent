{
  "name": "d4ff6c0c-679b-40ce-8ca8-6dd83a9e0477",
  "displayName": "Prompt Phone Number",
  "form": {
    "parameters": [ {
      "displayName": "telephone_otp",
      "required": true,
      "entityType": "@sys.phone-number",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.local_no_match_phone = 1"
            }, {
              "condition": "$session.params.telephone_otp_counter = 0",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Quel est le numéro de téléphone que je peux utiliser?" ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local error handling for Phone Number",
          "event": "sys.no-input-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "local_no_match_phone",
              "value": "$sys.func.ADD($session.params.local_no_match_phone,1)"
            } ]
          },
          "name": "4e742ed2-ab84-4276-9101-b51fb82c7af7"
        }, {
          "targetPage": "Local error handling for Phone Number",
          "event": "sys.no-match-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "local_no_match_phone",
              "value": "$sys.func.ADD($session.params.local_no_match_phone,1)"
            } ]
          },
          "name": "fff26636-04d7-4e37-bf87-284d9edaf224"
        } ]
      }
    } ]
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "speak_to_agent_counter",
      "value": 0
    } ]
  },
  "transitionRoutes": [ {
    "intent": "other_speak_to_agent",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "local_no_match_phone",
        "value": "$sys.func.ADD($session.params.local_no_match_phone,1)"
      } ]
    },
    "targetPage": "Local error handling for Phone Number",
    "name": "b32f3657-6a18-4e5b-b22b-41c8839d13a3"
  }, {
    "intent": "context.user_asks_more_time",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "\u003cspeak\u003eAbsolument. Veuillez prendre un moment pour trouver votre numéro. \u003cbreak time=\"5s\"/\u003e \u003c/speak\u003e" ]
        },
        "languageCode": "fr-ca"
      }, {
        "text": {
          "text": [ "\u003cspeak\u003eAbsolutely. Please take a moment to find your number.\u003cbreak time=\"5s\"/\u003e\u003c/speak\u003e" ]
        },
        "languageCode": "en"
      } ]
    },
    "name": "1111503d-fc3b-435e-a53a-5234c31b4308"
  }, {
    "intent": "context.cant_say_out_loud",
    "condition": "$session.params.Loud_Counter = 2",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "il semble y avoir un problème." ]
        },
        "languageCode": "fr-ca"
      }, {
        "text": {
          "text": [ "There seems to be a problem." ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "auth_status",
        "value": "Fail"
      }, {
        "parameter": "status",
        "value": "SMSTimeout"
      } ]
    },
    "targetPage": "Webhook set-auth-status",
    "name": "ab62ef79-5bd0-480d-af54-4d56e751d743"
  }, {
    "intent": "context.cant_say_out_loud",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Ne t'inquiète pas, si tu ne peux pas lire ton numéro à voix haute, tu peux le saisir à l'aide de ton clavier." ]
        },
        "languageCode": "fr-ca"
      }, {
        "text": {
          "text": [ "No worries, if you can't read your number out loud, you can enter it using your key pad." ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "Loud_Counter",
        "value": "$sys.func.ADD($session.params.Loud_Counter,1)"
      } ]
    },
    "name": "ea4c564d-6c3a-48d9-8037-49548df9bfa2"
  }, {
    "condition": "$session.params.telephone_otp != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "CIRN_1",
        "value": "$sys.func.SUBSTITUTE($session.params.telephone_otp, \"[^0-9]\", \"\")"
      }, {
        "parameter": "CIRN_Len",
        "value": "$sys.func.LEN($session.params.CIRN_1)"
      }, {
        "parameter": "CIRN_1st_Pos",
        "value": "$sys.func.MID($session.params.CIRN_1, 1, 1)"
      }, {
        "parameter": "CIRN_11_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos =  1  AND $session.params.CIRN_Len = 11\", $sys.func.MID($session.params.CIRN_1,2,10), \"\")"
      }, {
        "parameter": "CIRN_11_digit_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos !=  1 AND $session.params.CIRN_Len = 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len = 10\", $session.params.CIRN_1, \"\")"
      }, {
        "parameter": "CIRN_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len != 10 OR $session.params.CIRN_Len != 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_10_digit_Valid) = 10\", \"$session.params.CIRN_10_digit_Valid\", \"\")"
      }, {
        "parameter": "CIRN1",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_11_digit_Valid) = 10\", \"$session.params.CIRN_11_digit_Valid\", \"$session.params.CIRN_10\")"
      }, {
        "parameter": "CIRN1",
        "value": "$sys.func.IF(\"($session.params.CIRN1:0000000000) OR ($session.params.CIRN:1111111111) OR ($session.params.CIRN:2222222222) OR ($session.params.CIRN:3333333333) OR ($session.params.CIRN:4444444444) OR ($session.params.CIRN:5555555555) OR ($session.params.CIRN:6666666666) OR ($session.params.CIRN:7777777777) OR ($session.params.CIRN:8888888888) OR ($session.params.CIRN:9999999999)\", \"\", $session.params.CIRN)"
      }, {
        "parameter": "CIRN_flag",
        "value": "$sys.func.IS_PHONE_NUMBER($session.params.CIRN1, \"CA\")"
      } ]
    },
    "targetPage": "Phone Validation",
    "name": "a3d277a8-c30f-484a-ad5e-59a4a10ed120"
  } ]
}
