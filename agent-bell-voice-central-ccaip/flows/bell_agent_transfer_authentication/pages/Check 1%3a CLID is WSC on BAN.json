  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "_ban_account",
      "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$.users[*].billing_accounts[?(@.billing_account_number == '$session.params.billing_account')]\")"
    }, {
