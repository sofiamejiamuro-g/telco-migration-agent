  }, {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "reported_by",
        "value": "$session.params.contact_name"
      } ]
    },
    "targetPage": "Dispatch Status Check",
    "name": "ad174757-b132-4af2-8451-be283b315051"
  } ]
}
