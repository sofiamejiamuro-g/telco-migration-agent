  "entryFulfillment": {
    "messages": [ {
      "text": {
        "text": [ "You can now cancel pre-authorized payments at your own convenience. I'll send a text to the device you're calling from with a link to proceed. Is this alright?" ]
      },
      "languageCode": "en"
    }, {
      "text": {
        "text": [ "Vous pouvez maintenant annuler les prélèvements automatiques à votre convenance. Je vais vous envoyer un SMS sur l'appareil que vous utilisez actuellement avec un lien pour poursuivre.Est-ce que cela vous va?" ]
      },
      "languageCode": "fr-ca"
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.confirm_yes",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "sms_type",
        "value": "Public"
      }, {
        "parameter": "sms_content",
        "value": "You can visit https://m.bell.ca/chatmanagepaymente to cancel Pre Authorized payments in MyBell. (bell.ca/about-us )"
      } ]
    },
    "targetPage": "Lang based SMS",
    "name": "de239410-c2e6-454c-9cf9-b09cb17b3d66"
  }, {
    "intent": "context.confirm_no",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Unfortunately, Pre-Authorized cancellation can only be done in MyBell. Please visit bell.ca/support  on how to cancel Pre-Authorized payments." ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "sms_send_status",
        "value": "Declined"
