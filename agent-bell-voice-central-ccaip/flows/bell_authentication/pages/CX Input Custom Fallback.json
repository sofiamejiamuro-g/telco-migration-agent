        "languageCode": "fr-ca"
      }, {
        "text": {
          "text": [ "\u003cspeak\u003eI didn't receive your response. You can check out our frequently asked questions at \u003csay-as interpret-as=\"url\"\u003ebell.ca/support\u003c/say-as\u003e\u003c/speak\u003e" ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "auth_repeat",
        "value": 0
