              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Cela ne semble pas correspondre à ce que nous avons dans nos fichiers. Pouvez-vous réessayer?" ]
                  },
                  "languageCode": "fr-ca"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "That doesn't seem to match your 4-digit PIN. Can you please try again?" ]
                  },
                  "languageCode": "en"
                }
              } ]
            }, {
              "condition": "$session.params.PIN_Invalid_Counter != 2 AND $session.params.More_Time_Counter = 0 AND $session.params.Loud_Counter = 0 AND $session.params.Mistake_Counter = 0 AND $session.params.Agent_Counter = 0 AND $session.params.Error_Count \u003c= 5 AND $session.params.auth_repeat != 1 AND $session.params.speak_to_agent_counter = 0 AND $session.params.pin = 6",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Cela ne semble pas correspondre au code que je vous ai envoyé. Pouvez-vous réessayer ?" ]
                  },
                  "languageCode": "fr-ca"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "That doesn't seem to match the code I sent you. Can you give that another try?" ]
                  },
                  "languageCode": "en"
                }
              } ]
            } ]
          } ],
          "nextActionOverride": {
          
          }
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error handling - CX Input Custom Fallback",
          "event": "sys.no-input-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ],
            "nextActionOverride": {
            
            }
          },
          "name": "8b1b4034-ae2e-435f-be29-28630e34e643"
        }, {
          "targetPage": "Local Error handling - CX Input Custom Fallback",
          "event": "sys.no-match-1",
          "triggerFulfillment": {
            "messages": [ {
              "text": {
                "text": [ "That still does not seem right." ]
              },
              "languageCode": "en"
            } ],
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_nomatch_counter",
              "value": "$sys.func.ADD($session.params.local_nomatch_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_match"
            } ]
          },
          "name": "0ea8646f-2d3a-41ba-b246-03575ab49417"
        } ]
      },
      "redact": true,
      "advancedSettings": {
        "dtmfSettings": {
          "enabled": true,
          "maxDigits": 6,
          "finishDigit": "#",
          "useSystemEntityRule": false,
          "interdigitTimeoutDuration": {
