{
  "name": "9333cbc5-2aac-4c6f-89cc-c94b97f0c906",
  "displayName": "PIN Auth - Start",
  "form": {
    "parameters": [ {
      "displayName": "pin",
      "required": true,
      "entityType": "@sys.number-sequence",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.local_noinput_counter = 1 OR $session.params.local_nomatch_counter = 1"
            }, {
              "condition": "$session.params.Wrong_PIN_Counter = 0 AND $session.params.Loud_Counter = 0 AND $session.params.auth_repeat = 0 AND $session.params.speak_to_agent_counter = 0 AND $session.params.More_Time_Counter = 0",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "To help with that, I need to make sure I'm talking to the right person. I see you have a PIN on file. Please enter your 4-digit PIN." ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "Pour vous aider, je dois m'assurer de parler à la bonne personne. Je vois qu'il y a un NIP dans votre dossier. Veuillez entrer votre NIP de quatre chiffres." ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error handling - Pin Auth - Start",
          "event": "sys.no-input-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ]
          },
          "name": "4a5e0732-e130-4786-ac0a-92c3ca49997e"
        }, {
          "targetPage": "Local Error handling - Pin Auth - Start",
          "event": "sys.no-match-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_nomatch_counter",
              "value": "$sys.func.ADD($session.params.local_nomatch_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_match"
            } ]
          },
          "name": "4d565e77-e35f-4f6d-9099-1a9b7b35830b"
        } ]
      },
      "advancedSettings": {
        "dtmfSettings": {
          "enabled": true,
          "maxDigits": 4,
          "useSystemEntityRule": false,
          "interdigitTimeoutDuration": {
            "seconds": 5
          },
          "endpointingTimeoutDuration": {
            "seconds": 5
          }
        }
      }
    } ]
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "pin",
      "value": null
    }, {
      "parameter": "from_pin",
      "value": true
    }, {
      "parameter": "local_trigger",
      "value": null
    }, {
      "parameter": "local_nomatch_counter",
      "value": 0
    } ]
  },
  "transitionRoutes": [ {
    "intent": "other_speak_to_agent",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Désolé, cela ne semble pas exact. Veuillez dire ou entrer votre NIP de quatre chiffres." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "local_noinput_counter",
        "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
      } ]
    },
    "targetPage": "Local Error handling - Pin Auth - Start",
    "name": "d0ea4e8d-8100-47b2-b9eb-3466eb2174e4"
  }, {
    "intent": "context.user_asks_more_time",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Absolutely. Please take a moment to find your number" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Absolument. Tu peux prendre un moment pour trouver ton numéro." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "More_Time_Counter",
        "value": 1
      } ]
    },
    "name": "8ae4428d-2b5d-4f47-a9ff-9a26ab8c139a"
  }, {
    "intent": "context.cant_say_out_loud",
