{
  "name": "f0501236-2e90-4374-a091-9795f4b4df97",
  "displayName": "Prompt Phone Number",
  "form": {
    "parameters": [ {
      "displayName": "telephone_otp",
      "required": true,
      "entityType": "@sys.phone-number",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.local_noinput_counter = 1"
            }, {
              "condition": "$session.params.telephone_otp_counter = 0 AND $session.params.speak_to_agent_counter = 0 AND $session.params.auth_repeat = 0 AND $session.params.More_Time_Counter = 0 AND $session.params.Loud_Counter = 0",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Which phone number on your account would you like me to send it to?" ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "À quel numéro de téléphone souhaitez-vous que je l'envoie ?" ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error handling - Prompt Phone Number",
          "event": "sys.no-input-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ]
          },
          "name": "713e23ac-78eb-4953-8671-fb26a4a00c7c"
        }, {
          "targetPage": "Local Error handling - Prompt Phone Number",
          "event": "sys.no-match-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "local_trigger",
              "value": "no_match"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            } ]
          },
          "name": "e34d2b3a-cd17-4b0e-9a38-8ac10c436b9e"
        } ]
      },
      "redact": true,
      "advancedSettings": {
        "dtmfSettings": {
          "enabled": true,
          "maxDigits": 11,
          "useSystemEntityRule": false,
          "interdigitTimeoutDuration": {
            "seconds": 5
          },
          "endpointingTimeoutDuration": {
            "seconds": 5
          }
        }
      }
    } ]
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "local_nomatch_counter",
      "value": 0
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.same_number",
    "condition": "$session.params.clid != null AND $session.params.clid_not_found != true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "telephone_otp",
        "value": "$session.params.clid"
      }, {
        "parameter": "CIRN_1",
        "value": "$sys.func.SUBSTITUTE($session.params.telephone_otp, \"[^0-9]\", \"\")"
      }, {
        "parameter": "CIRN_Len",
        "value": "$sys.func.LEN($session.params.CIRN_1)"
      }, {
        "parameter": "CIRN_1st_Pos",
        "value": "$sys.func.MID($session.params.CIRN_1, 1, 1)"
      }, {
        "parameter": "CIRN_11_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos =  1  AND $session.params.CIRN_Len = 11\", $sys.func.MID($session.params.CIRN_1,2,10), \"\")"
      }, {
        "parameter": "CIRN_11_digit_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos !=  1 AND $session.params.CIRN_Len = 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len = 10\", $session.params.CIRN_1, \"\")"
      }, {
        "parameter": "CIRN_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len != 10 OR $session.params.CIRN_Len != 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_10_digit_Valid) = 10\", \"$session.params.CIRN_10_digit_Valid\", \"\")"
      }, {
        "parameter": "CIRN1",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_11_digit_Valid) = 10\", \"$session.params.CIRN_11_digit_Valid\", \"$session.params.CIRN_10\")"
      }, {
        "parameter": "CIRN1",
        "value": "$sys.func.IF(\"($session.params.CIRN1:0000000000) OR ($session.params.CIRN:1111111111) OR ($session.params.CIRN:2222222222) OR ($session.params.CIRN:3333333333) OR ($session.params.CIRN:4444444444) OR ($session.params.CIRN:5555555555) OR ($session.params.CIRN:6666666666) OR ($session.params.CIRN:7777777777) OR ($session.params.CIRN:8888888888) OR ($session.params.CIRN:9999999999)\", \"\", $session.params.CIRN)"
      }, {
        "parameter": "CIRN_flag",
        "value": "$sys.func.IS_PHONE_NUMBER($session.params.CIRN1, \"CA\")"
      }, {
        "parameter": "is_telephone_otp_wsn",
        "value": "$sys.func.CONTAIN($session.params.otp_number_list, $session.params.telephone_otp)"
      }, {
        "parameter": "auth_repeat",
        "value": 0
      }, {
        "parameter": "More_Time_Counter",
        "value": 0
      } ]
    },
    "targetPage": "Phone Validation",
    "name": "48d223aa-14a3-4ef7-a3a2-09fd78684696"
  }, {
    "intent": "other_speak_to_agent",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Désolé, cela ne semble pas exact. Veuillez dire ou entrer le numéro de dix chiffres auquel vous souhaitez que le code soit envoyé. Il doit s'agir d'un numéro inscrit à votre compte." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "local_noinput_counter",
        "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
      } ]
    },
    "targetPage": "Local Error handling - Prompt Phone Number",
    "name": "3b721e00-21f5-4277-b066-9ea2c444c997"
  }, {
    "intent": "context.user_asks_more_time",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Absolutely. Please take a moment to find your number." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Absolument. Tu peux prendre un moment pour trouver ton numéro." ]
        },
        "languageCode": "fr-ca"
      } ]
    },
    "name": "5e5e34f7-4c64-4a10-b8e8-0b5d11d6ec95"
  }, {
    "intent": "context.cant_say_out_loud",
    "condition": "$session.params.Loud_Counter = 3",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook SDL mapping ",
    "name": "3d1d30d2-72f7-43bb-9561-38a9c20e8584"
  }, {
    "intent": "context.cant_say_out_loud",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "No worries, if you can't read your number out loud, you can enter it using your key pad." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "No worries, if you can't read your number out loud, you can enter it using your key pad.\n" ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "Loud_Counter",
        "value": "$sys.func.ADD($session.params.Loud_Counter,1)"
      } ]
    },
    "name": "b957dbb2-43ce-4b9d-b761-8303b95f276b"
  }, {
