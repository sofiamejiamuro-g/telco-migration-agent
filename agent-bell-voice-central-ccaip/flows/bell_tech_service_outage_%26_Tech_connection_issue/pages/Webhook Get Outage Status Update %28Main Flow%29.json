{
  "name": "d5a07824-4b7b-4892-95dd-6433ae85a230",
  "displayName": "Webhook Get Outage Status Update (Main Flow)",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/digital-tools/outage-check#status-update",
    "tag": "status-update",
    "setParameterActions": [ {
      "parameter": "pf_id",
      "value": "$session.params.oc_start_response.pf_id"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "outage_counter",
        "value": "$sys.func.ADD($session.params.outage_counter,1)"
      } ]
    },
    "targetPage": "is_finished = true? (Main Flow)",
    "name": "3af4e0d9-5f1b-4681-8387-b8e8da9ba5b7"
  }, {
    "condition": "true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Failed Outage Check",
    "name": "cleanup-hardstop-route"
  } ],
  "eventHandlers": [ {
    "targetPage": "Failed Outage Check",
    "event": "webhook.error",
    "triggerFulfillment": {
    
    },
    "name": "a0ce0195-4df2-4004-87f3-9af06c96b367"
  }, {
    "targetPage": "Failed Outage Check",
    "event": "webhook.error.bad-request",
