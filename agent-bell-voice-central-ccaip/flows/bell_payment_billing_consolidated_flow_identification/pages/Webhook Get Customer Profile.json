{
  "name": "4dbf74a0-bfb7-4e77-9d07-3a7261468195",
  "displayName": "Webhook Get Customer Profile",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "/v1/ibm_mw/nm1_get#customer-profile",
