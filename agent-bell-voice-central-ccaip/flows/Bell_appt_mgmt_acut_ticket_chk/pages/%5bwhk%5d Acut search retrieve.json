{
  "name": "d26d3dcd-b236-461b-a831-482b9f8ccbc7",
  "displayName": "[whk] Acut search retrieve",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/ticket_management/acut/search#retrieve",
    "tag": "\"retrieve\""
  },
  "transitionRoutes": [ {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "street_number",
        "value": "$session.params.acut_retrieve_response.acutContext.geographicAddress.urbanPropertyAddress.streetNrFirst"
      }, {
        "parameter": "street_name",
        "value": "$session.params.acut_retrieve_response.acutContext.geographicAddress.urbanPropertyAddress.streetName"
      }, {
        "parameter": "sub_unit",
        "value": "$sys.func.IF(\"$session.params.acut_retrieve_response.acutContext.geographicAddress.urbanPropertyAddress.urbanPropertySubAddress.subUnitNr != null\", $session.params.acut_retrieve_response.acutContext.geographicAddress.urbanPropertyAddress.urbanPropertySubAddress.subUnitNr,\"\")"
      }, {
        "parameter": "address",
        "value": "$session.params.acut_retrieve_response.acutContext.geographicAddress.urbanPropertyAddress"
      }, {
        "parameter": "street_address",
        "value": "$sys.func.TO_OBJECT($session.params.address)"
      } ]
    },
    "name": "c249eb99-8063-423a-8a1c-2dfef0afc00b"
  }, {
    "condition": "$sys.func.UPPER($session.params.ticket_state) = \"ACTIVE\" AND $session.params.webhook_success = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Check ticket retrieved",
    "name": "077328ce-6a13-4c9a-bfcf-0ff07da08c2f"
  }, {
    "condition": "$sys.func.UPPER($session.params.ticket_state) = \"FINALIZED\" AND $session.params.webhook_success = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "[whk] ACUT trouble type - historical tickets",
    "name": "f9af9c22-6bb9-4598-9879-5d5cb5c91bf2"
  }, {
    "condition": "$session.params.webhook_success = false",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook Failure - ACUT",
    "name": "1febb0e7-623e-4118-a256-bdfff0f3650a"
  }, {
    "condition": "true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook Failure - ACUT",
    "name": "cleanup-hardstop-route"
  } ],
  "eventHandlers": [ {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error",
    "triggerFulfillment": {
    
    },
    "name": "95df1984-3789-42e8-b5e0-d92492855d64"
  }, {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error.bad-request",
    "triggerFulfillment": {
    
    },
    "name": "3b03244c-3399-4b68-b65f-a1de132f1382"
  }, {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error.timeout",
    "triggerFulfillment": {
    
    },
    "name": "60ef4fce-8524-45b2-a79a-ca2ee6688f32"
  }, {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error.not-found",
    "triggerFulfillment": {
    
    },
    "name": "6efb5cf2-f318-49e8-9cdc-d69ea228d69f"
  }, {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error.rejected",
    "triggerFulfillment": {
    
    },
    "name": "7b764aeb-e275-4d90-ab80-55494fb65d1f"
  }, {
    "targetPage": "Webhook Failure - ACUT",
    "event": "webhook.error.unavailable",
