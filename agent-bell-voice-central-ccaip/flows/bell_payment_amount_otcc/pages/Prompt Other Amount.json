    "name": "9d2ec6bf-774d-4edf-b4bb-c0813868358f"
  }, {
    "condition": "($session.params.special_status = \"bell_col_aul\" OR $session.params.special_status = \"bell_col_sus\") AND $session.params.other_payment_amount != null",
