        "generator": "projects/gcp-it-npe-auth-va-dlgflw/locations/us-central1/agents/8fb0c680-c945-4186-b6ab-47b4baeba61d/generators/699af4a5-d41f-47b3-a735-9489ddc4be5f",
        "outputParameter": "$session.params.amount_paid"
