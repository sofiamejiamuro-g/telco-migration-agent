{
  "name": "97138759-b0b3-40fa-a46b-3e3e99221545",
  "displayName": "Prompt Past Due Amount Dlqt",
  "form": {
    "parameters": [ {
      "displayName": "customer_mentioned_amount",
      "entityType": "@sys.number-sequence",
      "fillBehavior": {
        "initialPromptFulfillment": {
        
        }
      }
    } ]
  },
  "entryFulfillment": {
    "messages": [ {
      "text": {
        "text": [ "In order to pay your past due amount you'll need to make a minimum payment of $ $session.params.due_amount.  Would you like to proceed with that amount?" ]
      },
      "languageCode": "en"
    }, {
      "text": {
        "text": [ "Afin de payer suffisamment pour rétablir vos services, vous devrez effectuer un paiement minimum de $ $session.params.due_amount Voulez-vous procéder avec ce montant?" ]
      },
      "languageCode": "fr-ca"
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.confirm_yes",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Great." ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "amount_paid",
        "value": "$session.params.due_amount"
      } ]
    },
    "targetFlow": "bell_payment_cc_details_input",
    "name": "9bc90283-fa07-47a5-a347-74934d56c66a"
  }, {
    "intent": "context.pa_amount_and_no",
    "condition": "$session.params.customer_mentioned_amount != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "other_payment_amount",
        "value": "$session.params.customer_mentioned_amount"
      }, {
        "parameter": "customer_mentioned_amount",
        "value": null
      }, {
        "parameter": "from_non_restricted",
        "value": "$sys.func.IF(\"$session.params.other_payment_amount \u003c $session.params.due_amount\", true, null)"
      } ]
    },
    "targetPage": "Amount Already Provided",
    "name": "7d4a8ca9-2b9c-4d95-a5aa-f12b4445c9f0"
  }, {
    "intent": "context.confirm_no",
    "condition": "$session.params.other_amount_value != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "other_payment_amount",
        "value": "$session.params.other_amount_value"
      }, {
        "parameter": "from_non_restricted",
        "value": "$sys.func.IF(\"$session.params.other_payment_amount \u003c $session.params.due_amount\", true, null)"
      } ]
    },
    "targetPage": "Amount Already Provided",
    "name": "cb1e11e6-b783-4920-b2e0-e8817737790f"
  }, {
    "intent": "context.confirm_no",
