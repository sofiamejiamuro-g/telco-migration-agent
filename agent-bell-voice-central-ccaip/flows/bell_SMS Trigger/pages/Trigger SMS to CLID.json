{
  "name": "e8c036e2-7acb-4881-b594-e8400914a846",
  "displayName": "Trigger SMS to CLID",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v2/self-help-messaging",
    "tag": "sms",
    "setParameterActions": [ {
      "parameter": "telephone_number",
      "value": "$session.params.clid"
    }, {
      "parameter": "brand",
      "value": "bell"
    }, {
      "parameter": "message_text",
      "value": "$session.params.sms_content"
    }, {
      "parameter": "tag",
      "value": "sms"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = \"True\"",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "\u003cspeak\u003e I've just sent you the text message. It may take a moment to arrive. \u003cbreak time=\"2s\"/\u003e Please let me know if you don't receive it, or if you just need more time to review it. \u003c/speak\u003e" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "\u003cspeak\u003e Je viens de vous envoyer un message texte. Il peut prendre quelques instants avant d’arriver. \u003cbreak time=\"2s\"/\u003e Veuillez m'aviser si vous ne le recevez pas, ou si vous avez simplement besoin de plus de temps pour le consulter. \u003c/speak\u003e" ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "sms_sending",
        "value": "Success"
      } ]
    },
    "targetPage": "SMS Confirmation",
    "name": "3829981e-0824-4ff6-87b4-65e5f01826f0"
