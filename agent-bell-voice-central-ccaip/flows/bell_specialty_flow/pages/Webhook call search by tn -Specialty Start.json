{
  "name": "bd63a9cc-5e99-4feb-9cbb-981eb1cfd6e9",
  "displayName": "Webhook call search by tn -Specialty Start",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/customer-identification#search-by-tn",
    "tag": "search-by-tn",
    "setParameterActions": [ {
      "parameter": "telephone_number",
      "value": "$session.params.clid"
    }, {
      "parameter": "tag",
      "value": "search-by-tn"
    }, {
      "parameter": "webhook_success",
      "value": null
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "customer_id_search_response",
        "value": "$sys.func.TO_OBJECT($session.params.customer_id_search_response)"
      }, {
        "parameter": "province_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$..billing_address.stateOrProvince\")"
      }, {
        "parameter": "province",
        "value": "$session.params.province_list[0]"
      }, {
        "parameter": "billing_account_number_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$..billing_account_number\")"
      }, {
        "parameter": "n_billing_account",
        "value": "$sys.func.COUNT($session.params.billing_account_number_list)"
      }, {
        "parameter": "is_prepaid_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$[*].users[?(@.contact_number == '$session.params.CIRN')].billing_accounts[*].billing_account_number\")"
      }, {
        "parameter": "is_prepaid",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].services[0].is_prepaid"
      }, {
        "parameter": "billing_account_info_list",
        "value": "$sys.func.GET_FIELD($sys.func.GET($sys.func.GET_FIELD($session.params.customer_id_search_response, \"users\"), 0), \"billing_accounts\")"
      }, {
        "parameter": "active_lob",
        "value": "$sys.func.FILTER(\"$session.params.billing_account_info_list\", \"$[*].services[*].service_type\")"
      }, {
        "parameter": "mobility",
        "value": "$sys.func.CONTAIN(   $session.params.active_lob,   \"MOBILITY\" )"
      }, {
        "parameter": "tv",
        "value": "$sys.func.CONTAIN(   $session.params.active_lob,   \"TV\" )"
      }, {
        "parameter": "internet",
        "value": "$sys.func.CONTAIN(   $session.params.active_lob,   \"INTERNET\" )"
      }, {
        "parameter": "smarthome",
        "value": "$sys.func.CONTAIN(   $session.params.active_lob,   \"Smart home\" )"
      }, {
        "parameter": "homephone",
        "value": "$sys.func.CONTAIN(   $session.params.active_lob,   \"Homephone\" )"
      }, {
        "parameter": "total_active_services",
        "value": "$sys.func.FILTER(\"$session.params.billing_account_info_list\", \"$[*].services[*].service_type\")"
      }, {
        "parameter": "total_unique_services",
        "value": "$sys.func.UNIQUE($session.params.total_active_services)"
      }, {
        "parameter": "n_unique_service",
        "value": "$sys.func.COUNT($session.params.total_unique_services)"
      } ]
    },
    "name": "6df113f4-2825-4537-a7e8-e6154daf4c74"
  }, {
    "condition": "$session.params.webhook_success = false",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "webhook_success",
        "value": null
      } ]
    },
    "targetPage": "webhook- DEAI- Distributel_pending_order",
    "name": "f6fdcf7a-9db2-4fd8-80ca-9f6cd39b40e3"
  }, {
    "condition": "$session.params.n_billing_account \u003e 1",
    "triggerFulfillment": {
    
    },
    "targetPage": "webhook- DEAI- Distributel_pending_order",
    "name": "7092ba5f-c1b3-460e-950f-0b6569a7ecce"
  }, {
    "condition": "$session.params.n_billing_account = 1 AND $session.params.is_prepaid = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "CIRN",
        "value": "$session.params.clid"
      }, {
        "parameter": "identification_status",
        "value": "Pass"
      }, {
        "parameter": "customer_type",
        "value": "Existing"
      } ]
    },
    "targetFlow": "bell_va_to_ivr_handoff_prepaid",
    "name": "0956ad40-5766-48f6-8bdd-7b2cf2657c67"
  }, {
    "condition": "$session.params.is_prepaid = true AND $session.params.n_unique_service = 1",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "identification_status",
        "value": "Pass"
      }, {
        "parameter": "customer_type",
        "value": "Existing"
      }, {
        "parameter": "CIRN",
        "value": "$session.params.clid"
      } ]
    },
    "targetFlow": "bell_va_to_ivr_handoff_prepaid",
    "name": "3a9c584b-428f-4ecb-833b-93d6628ef9bb"
