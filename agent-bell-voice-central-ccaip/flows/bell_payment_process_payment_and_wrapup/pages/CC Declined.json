{
  "name": "ea701c73-95b8-43ff-97d9-4018cb70a079",
  "displayName": "CC Declined",
  "form": {
  
  },
  "entryFulfillment": {
    "conditionalCases": [ {
      "cases": [ {
        "condition": "$session.params.cc_failed_attempt \u003c 2",
        "caseContent": [ {
          "message": {
            "text": {
              "text": [ "Unfortunately, I wasn't able to process your payment. This can happen for a few different reasons. Would you like to enter your card details again or try using a different card? Please say yes or no." ]
            },
            "languageCode": "en"
          }
        }, {
          "message": {
            "text": {
              "text": [ "Malheureusement, je n'ai pas pu traiter votre paiement. Cela peut arriver pour plusieurs raisons. Souhaitez-vous saisir à nouveau vos informations de carte ou essayer avec une autre carte? Veuillez répondre oui ou non." ]
            },
            "languageCode": "fr-ca"
          }
        } ]
      } ]
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.confirm_yes",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "cc_failed_attempt",
        "value": "$sys.func.ADD(1, $session.params.cc_failed_attempt)"
      } ]
    },
    "targetFlow": "bell_payment_cc_details_input",
    "name": "c74b933c-fe8c-4ae5-9fe7-11afdb621be3"
  }, {
    "intent": "context.confirm_no",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "OK, you can always try again later using the MyBell app." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "D’accord, vous pouvez toujours réessayer plus tard en utilisant l’appli MonBell." ]
        },
        "languageCode": "fr-ca"
      } ]
    },
    "targetFlow": "bell_Feedback",
    "name": "a22624bf-3e8e-448c-9806-b42aa8fd8a59"
  }, {
    "condition": "$session.params.cc_failed_attempt = 2",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Unfortunately I’m unable to proceed with your request right now. For more information regarding your payment and account status please visit the MyBell app." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Malheureusement, je ne suis pas en mesure de traiter votre demande pour le moment. Pour plus d’informations concernant votre paiement et l’état de votre compte, veuillez consulter l’appli MonBell." ]
        },
        "languageCode": "fr-ca"
      } ]
