      "setParameterActions": [ {
        "parameter": "mya_pitch",
        "value": true
      } ]
    },
    "targetFlow": "bell_appt_mgmt_mya_pitch_1",
    "name": "c825ed2c-5f3c-4690-ad2f-d4f8a37be896"
  }, {
    "condition": "$session.params.mya_pitch = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
