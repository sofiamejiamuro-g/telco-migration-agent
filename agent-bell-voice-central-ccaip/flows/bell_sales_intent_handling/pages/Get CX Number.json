{
  "name": "f1add17b-c299-4219-8a26-5cb6318e8a36",
  "displayName": "Get CX Number",
  "form": {
    "parameters": [ {
      "displayName": "CIRN",
      "required": true,
      "entityType": "@sys.phone-number",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.More_Time_Counter = 0 AND $session.params.Loud_Counter = 0 AND $session.params.Mistake_Counter = 0",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Okay, what's the 10-digit phone number associated with your service?" ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "D'accord, quel est le numéro de téléphone de 10 chiffres associé à votre service?" ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error Handling",
          "event": "sys.no-input-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "identification_status",
              "value": "Fail"
            }, {
              "parameter": "line_type",
              "value": "Existing"
            }, {
              "parameter": "customer_type",
              "value": "Existing"
            }, {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ]
          },
          "name": "9249033c-bc2b-424b-be35-dcc2b17d8c96"
        }, {
          "targetPage": "Local Error Handling",
          "event": "sys.no-match-default",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "identification_status",
              "value": "Fail"
            }, {
              "parameter": "line_type",
              "value": "Existing"
            }, {
              "parameter": "customer_type",
              "value": "Existing"
            }, {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_nomatch_counter",
              "value": "$sys.func.ADD($session.params.local_nomatch_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_match"
            } ]
          },
          "name": "22802858-c22b-4e1d-8f19-b085da49e78e"
        } ]
      },
      "advancedSettings": {
        "dtmfSettings": {
          "enabled": true,
          "maxDigits": 11,
          "useSystemEntityRule": false,
          "interdigitTimeoutDuration": {
            "seconds": 5
          },
          "endpointingTimeoutDuration": {
            "seconds": 5
          }
        }
      }
    } ]
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "CIRN",
      "value": null
    }, {
      "parameter": "local_trigger",
      "value": null
    }, {
      "parameter": "local_noinput_counter",
      "value": 0
    }, {
      "parameter": "local_nomatch_counter",
      "value": 0
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.confirm_yes",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "CIRN",
        "value": "$session.params.clid"
      } ]
    },
    "name": "1a6dbc57-229e-4f45-ba5f-a51ae8fa90fb"
  }, {
    "intent": "context.user_asks_more_time",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Absolutely. Please take a moment to find your number." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Absolument. Veuillez prendre un moment pour trouver votre numéro." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "More_Time_Counter",
        "value": "$sys.func.ADD(1, $session.params.More_Time_Counter)"
      } ]
    },
    "name": "4556706e-1d56-4afc-8045-049fb070ba82"
  }, {
    "intent": "context.cant_say_out_loud",
    "condition": "$session.params.Loud_Counter \u003e= 5",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "\u003cspeak\u003eI didn't receive your response. You can check out our frequently asked questions at \u003csay-as interpret-as=\"url\"\u003ebell.ca/support\u003c/say-as\u003e\u003c/speak\u003e" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "\u003cspeak\u003eJe n’ai pas reçu votre réponse. Vous pouvez consulter notre foire aux questions à l’adresse \u003csay-as interpret-as=\"url\"\u003evpc.ca/soutien\u003c/say-as\u003e\u003c/speak\u003e" ]
        },
        "languageCode": "fr-ca"
      } ]
    },
    "name": "a6bdf963-4770-469f-ae0e-665b0d5d2f9b"
  }, {
    "intent": "context.cant_say_out_loud",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "No worries, if you can't read your number out loud, you can enter it using your key pad." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Pas de souci; si vous ne pouvez pas lire votre numéro à voix haute, vous pouvez le saisir à l’aide de votre clavier." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "Loud_Counter",
        "value": "$sys.func.ADD(1, $session.params.Loud_Counter)"
      } ]
    },
    "name": "5509a1db-b075-483b-903f-f19bbc8899bc"
  }, {
    "intent": "context.user_makes_mistake",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "No worries, please say or re-enter your number when ready." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Pas de souci; veuillez dire ou saisir à nouveau votre numéro lorsque vous êtes prêt(e)." ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "Mistake_Counter",
        "value": "$sys.func.ADD(1, $session.params.Mistake_Counter)"
      } ]
    },
    "name": "82b87008-ca85-4fd1-8ca1-3db598b74ab5"
  }, {
    "condition": "$session.params.CIRN != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "CIRN_1",
        "value": "$sys.func.SUBSTITUTE($session.params.CIRN, \"[^0-9]\", \"\")"
      }, {
        "parameter": "CIRN_Len",
        "value": "$sys.func.LEN($session.params.CIRN_1)"
      }, {
        "parameter": "CIRN_1st_Pos",
        "value": "$sys.func.MID($session.params.CIRN_1, 1, 1)"
      }, {
        "parameter": "CIRN_11_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos =  1  AND $session.params.CIRN_Len = 11\", $sys.func.MID($session.params.CIRN_1,2,10), \"\")"
      }, {
        "parameter": "CIRN_11_digit_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_1st_Pos !=  1 AND $session.params.CIRN_Len = 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10_digit_Valid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len = 10\", $session.params.CIRN_1, \"\")"
      }, {
        "parameter": "CIRN_Invalid",
        "value": "$sys.func.IF(\"$session.params.CIRN_Len != 10 OR $session.params.CIRN_Len != 11\", \"\", \"\")"
      }, {
        "parameter": "CIRN_10",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_10_digit_Valid) = 10\", \"$session.params.CIRN_10_digit_Valid\", \"\")"
      }, {
        "parameter": "CIRN",
        "value": "$sys.func.IF(\"$sys.func.LEN($session.params.CIRN_11_digit_Valid) = 10\", \"$session.params.CIRN_11_digit_Valid\", \"$session.params.CIRN_10\")"
      }, {
        "parameter": "CIRN",
        "value": "$sys.func.IF(\"($session.params.CIRN:0000000000) OR ($session.params.CIRN:1111111111) OR ($session.params.CIRN:2222222222) OR ($session.params.CIRN:3333333333) OR ($session.params.CIRN:4444444444) OR ($session.params.CIRN:5555555555) OR ($session.params.CIRN:6666666666) OR ($session.params.CIRN:7777777777) OR ($session.params.CIRN:8888888888) OR ($session.params.CIRN:9999999999)\", \"\", $session.params.CIRN)"
      }, {
        "parameter": "CIRN_flag",
        "value": "$sys.func.IS_PHONE_NUMBER($session.params.CIRN, \"CA\")"
      }, {
        "parameter": "CIRN_999",
        "value": "$sys.func.MID($session.params.CIRN_1, 1, 3)"
      } ]
    },
    "targetPage": "Phone Validation",
    "name": "a62d738e-69ad-4a36-a178-56737fc7a132"
  } ]
}
