  }, {
    "condition": "$session.params.webhook_success = \"True\" OR $session.params.webhook_success = \"true\"",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "webhook_success",
        "value": null
      }, {
        "parameter": "customer_id_search_response",
        "value": "$sys.func.TO_OBJECT($session.params.customer_id_search_response)"
      }, {
        "parameter": "first_user_account",
        "value": "$sys.func.GET($sys.func.GET_FIELD($session.params.customer_id_search_response,\"users\"),0)"
      }, {
        "parameter": "service_type_list",
        "value": "$sys.func.UNIQUE($sys.func.FILTER(\"$session.params.first_user_account\", \"$.billing_accounts[*].services[*].service_type\"))"
      }, {
        "parameter": "n_service_type",
        "value": "$sys.func.COUNT($session.params.service_type_list)"
      }, {
        "parameter": "billing_account_number_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$..billing_account_number\")"
      }, {
        "parameter": "n_billing_account",
        "value": "$sys.func.COUNT($session.params.billing_account_number_list)"
      }, {
        "parameter": "is_prepaid_list",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\", \"$[*].users[?(@.contact_number == $session.params.CIRN)].billing_accounts[*].services[*].is_prepaid\")"
      }, {
        "parameter": "is_prepaid",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].services[0].is_prepaid"
      } ]
    },
    "name": "652a0664-c7d9-4448-bec5-d67045283c14"
  }, {
    "condition": "$session.params.n_billing_account = 1 AND $session.params.is_prepaid = false",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "identification_status",
        "value": "Pass"
      }, {
        "parameter": "line_type",
        "value": "Existing"
      }, {
        "parameter": "customer_type",
        "value": "Existing"
      }, {
        "parameter": "billing_account_number",
        "value": "$session.params.customer_id_search_response.users[0].billing_accounts[0].billing_account_number"
      }, {
        "parameter": "billing_account",
        "value": "$session.params.billing_account_number"
      }, {
        "parameter": "billing_account_info_list",
        "value": "$sys.func.GET_FIELD($sys.func.GET($sys.func.GET_FIELD($session.params.customer_id_search_response, \"users\"), 0), \"billing_accounts\")"
      } ]
    },
    "targetPage": "Webhook npa-nxx-lookup",
    "name": "3c8a07e0-9e5c-4557-b57a-3c1cf7d12dc9"
  }, {
