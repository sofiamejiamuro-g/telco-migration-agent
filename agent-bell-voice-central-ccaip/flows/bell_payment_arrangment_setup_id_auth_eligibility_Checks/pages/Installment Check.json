{
  "name": "20d91d32-4959-4c58-8c82-a96c45c7cb67",
  "displayName": "Installment Check",
  "form": {
  
  },
  "entryFulfillment": {
  
  },
  "transitionRoutes": [ {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "bill_date",
        "value": "$session.params.pmt_arrangement_eligibility_response.installmentDetails[0].dueDateOfPayment"
      }, {
        "parameter": "countInstallment",
        "value": "$sys.func.COUNT($session.params.pmt_arrangement_eligibility_response.installmentDetails)"
      }, {
        "parameter": "countInsatllment1",
        "value": "$sys.func.MINUS($session.params.countInstallment , 1)"
      }, {
        "parameter": "formatDate",
        "value": "$sys.func.MID($session.params.bill_date, 1, 10)"
      }, {
        "parameter": "amountRemaining",
