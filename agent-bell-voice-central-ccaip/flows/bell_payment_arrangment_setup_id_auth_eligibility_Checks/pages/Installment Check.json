              "text": {
                "text": [ "\u003cspeak\u003e Bonne nouvelle! Vous avez déjà configuré une entente de paiement. Votre prochain paiement de $$session.params.amountRemaining est dû le \u003csay-as interpret-as=\"date\" format=\"md\" detail=\"2\"\u003e" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "$session.params.date" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003c/say-as\u003e \u003c/speak\u003e" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003cspeak\u003e Good News! You already have an existing payment arrangement set up. Your next payment of $$session.params.amountRemaining is due on" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003csay-as interpret-as=\"date\" format=\"md\" detail=\"2\"\u003e" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "$session.params.date" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003c/say-as\u003e" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003c/speak\u003e" ]
              },
              "languageCode": "en"
            }
          } ]
        }, {
          "caseContent": [ {
            "message": {
              "text": {
                "text": [ "\u003cspeak\u003e Bonne nouvelle! Vous avez déjà configuré une entente de paiement. Votre entente de paiement est fixée à $$session.params.amountRemaining, le montant est dû le \u003csay-as interpret-as=\"date\" format=\"md\" detail=\"2\"\u003e" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "$session.params.date" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003c/say-as\u003e et vous avez un total de $session.params.countInsatllment1 / $session.params.countInstallment. Il reste un versement au CX \u003c/speak\u003e" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003cspeak\u003e Good News! You already have an existing payment arrangement set up.Your payment arrangement is set for $$session.params.amountRemaining,the amount is due on" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003csay-as interpret-as=\"date\" format=\"md\" detail=\"2\"\u003e" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "$session.params.date" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "\u003c/say-as\u003e  and you have a total of $session.params.countInstallment payment installments. \u003c/speak\u003e" ]
              },
              "languageCode": "en"
            }
          } ]
        } ]
      } ]
    },
    "targetFlow": "bell_Feedback",
