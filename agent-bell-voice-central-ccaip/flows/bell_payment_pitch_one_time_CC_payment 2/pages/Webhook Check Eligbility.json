    "name": "c14d0211-6845-463a-9ae2-6869f8270953"
  }, {
    "condition": "$session.params.eligibilityCriteria = false AND $session.params.webhook_success = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Check Result",
    "name": "12bba507-bade-40b3-aed6-a14cefb1333e"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "hardstop",
