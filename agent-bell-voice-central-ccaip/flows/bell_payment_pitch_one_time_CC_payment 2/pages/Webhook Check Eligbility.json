        "parameter": "webhook_success",
        "value": "$session.params.webhook_success"
      }, {
        "parameter": "installmentDetails",
        "value": "$session.params.pmt_arrangement_eligibility_response.installmentDetails"
      }, {
        "parameter": "installmentCheck",
