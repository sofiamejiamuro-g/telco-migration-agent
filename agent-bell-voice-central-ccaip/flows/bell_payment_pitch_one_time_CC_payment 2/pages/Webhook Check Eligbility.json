      } ]
    },
    "name": "95a94bbc-b3e6-4e6c-a9af-d5459235d614"
  }, {
    "condition": "$session.params.webhook_success = true AND $session.params.eligibilityCriteria = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Check Result",
    "name": "f1306d4a-66f5-4967-aac1-e53ebf54e211"
  }, {
    "condition": "$session.params.webhook_success = false",
    "triggerFulfillment": {
    
    },
