      }, {
        "parameter": "unique_services",
        "value": "$sys.func.UNIQUE($session.params.active_services)"
      }, {
        "parameter": "number_of_services",
        "value": "$sys.func.COUNT($session.params.unique_services)"
      }, {
        "parameter": "is_mobility",
        "value": "$sys.func.IF(sys.func.CONTAIN($session.params.unique_services, \"Mobility\")=true, true,  $sys.func.IF($sys.func.CONTAIN($session.params.unique_services, \"MOBILITY\")=true, true, false))"
      }, {
        "parameter": "number_of_services",
        "value": "$sys.func.IF($session.params.account_service_transfer_testing=true, $session.params.number_of_services_testing, $session.params.number_of_services)"
      }, {
        "parameter": "is_mobility",
        "value": "$sys.func.IF($session.params.account_service_transfer_testing=true, $session.params.is_mobility_testing, $session.params.is_mobility)"
