{
  "name": "0b1609c4-816c-4932-87a5-d7c59ae81ddb",
  "displayName": "Ask Date Again",
  "form": {
    "parameters": [ {
      "displayName": "day",
      "required": true,
      "entityType": "@sys.date",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "messages": [ {
            "text": {
              "text": [ "D’accord, pouvez-vous me redonner la date?" ]
            },
            "languageCode": "fr-ca"
          }, {
            "text": {
              "text": [ "Okay, can you provide the date again?" ]
            },
            "languageCode": "en"
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error handling + Ask Date Again",
          "event": "sys.no-input-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ]
          },
          "name": "5b67f04d-4836-4a8d-b924-acf798b74e9e"
        }, {
          "targetPage": "Local Error handling + Ask Date Again",
          "event": "sys.no-match-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_nomatch_counter",
              "value": "$sys.func.ADD($session.params.local_nomatch_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_match"
            } ]
          },
          "name": "8fc78167-c96d-4b86-a1ba-a9f19ece5c4e"
        } ]
      }
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$page.params.status = \"FINAL\"",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "ask_date_again",
        "value": "true"
      } ]
    },
    "targetPage": "Date Formatter",
    "name": "bfd91672-9baa-4c1b-8c10-633762ed0252"
  } ]
}
