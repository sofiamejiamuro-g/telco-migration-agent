{
  "name": "f31f37e3-a5ab-44e0-abc5-9483d3b4ee56",
  "displayName": "Prepare for CCAIP Transfer",
  "form": {
  
  },
  "transitionRoutes": [ {
    "condition": "$session.params.auth_status = null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "coming_from",
        "value": "bell_aqd"
      } ]
    },
    "targetFlow": "bell_agent_transfer_authentication",
    "name": "b9043104-9b30-49f5-ac62-8e5366eee0f3"
  }, {
    "condition": "$session.params.customer_authentication != true OR $session.params.auth_status != \"Pass\"",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "callKey",
        "value": ""
      }, {
        "parameter": "customer_authentication",
        "value": false
      } ]
    },
    "name": "8adee820-c1c5-43de-803d-3d5c2ca5198e"
  }, {
    "condition": "$session.params.callKey = null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "callKey",
        "value": ""
      }, {
        "parameter": "customer_authentication",
        "value": false
      } ]
    },
    "name": "54acb626-c71d-4e5b-b5fd-5cbec5ad10fd"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Let me check for an available agent. I'll likely be silent for some time during the transfer. You'll know it's successful when you're greeted again. Please stay on the line. Thanks!" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Laissez-moi vérifier si un agent est disponible. Il se peut que je ne réponde pas pendant un certain temps au cours du transfert.  Vous saurez que l’opération a réussi lorsque nous vous ferons de nouveau signe. Veuillez rester en ligne. Merci!" ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "va_to_ccaip",
        "value": true
      } ]
    },
    "targetFlow": "bell_Live Agent Handoff",
    "name": "9a8be80c-719f-47b7-bec8-7cbeb6fb05a2"
  } ]
}
