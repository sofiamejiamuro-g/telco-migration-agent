{
  "name": "64c9f1ad-883a-4af6-9348-0e1d5ff18ffb",
  "displayName": "Webhook Get Segment",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/aqd-support#get-segment",
    "tag": "get-segment",
    "setParameterActions": [ {
      "parameter": "brand",
      "value": "$session.params.brand"
    }, {
      "parameter": "menu_type",
      "value": "$session.params.menu_type"
    }, {
      "parameter": "webhook_success",
      "value": null
    }, {
      "parameter": "_empty_string",
      "value": ""
    }, {
      "parameter": "intent",
      "value": "$sys.func.IF(\"$session.params.route = $session.params._empty_string\" , other_speak_to_agent, $session.params.route)"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "segment",
        "value": "$session.params.get_segment_response.segment"
      } ]
    },
    "targetPage": "Check Special Status",
    "name": "5dbe237e-9c4c-4af6-a7ad-02b54d60c67e"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "segment",
        "value": "Care"
      } ]
    },
    "targetPage": "Check Special Status",
    "name": "0609509b-7cae-41a3-b23c-84b8dcb3737a"
  } ],
  "eventHandlers": [ {
    "targetPage": "Check Special Status",
    "event": "webhook.error",
