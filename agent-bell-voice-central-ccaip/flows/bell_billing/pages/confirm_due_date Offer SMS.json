  "entryFulfillment": {
    "messages": [ {
      "text": {
        "text": [ "Vous pouvez en savoir plus sur la date de facturation mensuelle dans l'application MonBell. Je vais vous envoyer un message texte sur l'appareil que vous utilisez en ce moment afin que vous puissiez voir cela vous-même. Est-ce que cela vous va?" ]
      },
      "languageCode": "fr-ca"
    }, {
      "text": {
        "text": [ "You can learn more about Monthly Charge Date on the MyBell app. I'll send a text to the device you're calling from with a link to view this yourself. Is that alright?" ]
      },
      "languageCode": "en"
    } ]
  },
