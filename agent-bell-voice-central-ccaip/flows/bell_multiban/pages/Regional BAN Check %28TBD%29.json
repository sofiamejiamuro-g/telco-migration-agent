{
  "name": "83768bc6-6e19-4398-84e2-a83992e35897",
  "displayName": "Regional BAN Check (TBD)",
  "form": {
  
  },
  "entryFulfillment": {
  
  },
  "transitionRoutes": [ {
    "condition": "$session.params.lob = null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "coming_from",
        "value": "multiban"
      } ]
    },
    "name": "376cedce-9758-4bf7-a916-680a0c7d30e4"
  }, {
    "condition": "$session.params.lob != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "billing_accounts_lob",
        "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\",$sys.func.CONCATENATE(\"$..billing_accounts[?(@.services[*].service_type =~ /(?i)^\",$sys.func.TO_TEXT($session.params.lob),\"$/)].billing_account_number\"))"
      }, {
        "parameter": "n_billing_accounts_lob",
        "value": "$sys.func.COUNT($session.params.billing_accounts_lob)"
      } ]
    },
    "targetPage": "Regional LOB Check",
    "name": "c59574ea-7e93-497e-bb10-7c04b1e2a4bb"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Could you also tell me your account number, please?" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Pourriez-vous également fournir votre numéro de compte?" ]
        },
        "languageCode": "fr-ca"
      } ]
    },
    "targetPage": "Account Number",
    "name": "bcea712a-907f-49ab-868d-3ffc7df93bec"
  } ]
}
