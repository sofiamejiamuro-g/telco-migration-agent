      "setParameterActions": [ {
        "parameter": "billing_account_mobility",
        "value": "$sys.func.UNIQUE(   $sys.func.FILTER(     \"$session.params.customer_id_search_response\",     \"$..billing_accounts[?(@.services[*].service_type =~ /(?i)^Mobility$/)].billing_account_number\"   ) )"
      }, {
        "parameter": "n_billing_account_mobility",
        "value": "$sys.func.COUNT($session.params.billing_account_mobility)"
      }, {
        "parameter": "billing_account_internet",
