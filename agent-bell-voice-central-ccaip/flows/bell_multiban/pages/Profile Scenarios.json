      }, {
        "parameter": "n_postcode_list_all",
        "value": "$sys.func.COUNT($session.params.postcode_list_all)"
      }, {
        "parameter": "i",
        "value": 0
      } ]
    },
    "targetPage": "Check - Unique Postcode",
    "name": "e2d3279c-7189-4288-a6d7-1ec71c367619"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "entry_route",
        "value": "ban_number"
      } ]
    },
    "targetPage": "Account Number",
    "name": "addd5f7e-eeb5-4173-990e-ae1fb76fb701"
  } ]
