      "parameter": "is_prepaid",
      "value": "$session.params.billing_account_info_list.services[0].is_prepaid"
    }, {
      "parameter": "service_id",
      "value": "$session.params.billing_account_info_list.services[*].service_id"
    }, {
      "parameter": "_subscriber_number",
      "value": "$sys.func.FILTER(\"$session.params.customer_data\", \"$..service_account_number\")"
    }, {
      "parameter": "subscriber_number",
      "value": "$sys.func.GET($session.params._subscriber_number, 0)"
    } ],
    "conditionalCases": [ {
      "cases": [ {
        "condition": "$session.params.SMB != true OR $session.params.CCC != true OR $session.params.BBM != true OR $session.params.atlantic != true OR $session.params.BNQ != true OR $session.params.MTS != true",
        "caseContent": [ {
          "message": {
            "text": {
              "text": [ "Thank you. I found the account." ]
            },
            "languageCode": "en"
          }
        }, {
          "message": {
            "text": {
              "text": [ "Merci. J’ai trouvé le compte." ]
            },
            "languageCode": "fr-ca"
          }
        } ]
      } ]
    } ]
  },
  "transitionRoutes": [ {
