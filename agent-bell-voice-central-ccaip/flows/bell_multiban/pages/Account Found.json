{
  "name": "7b1b77b5-ca1c-4266-ba44-cd4925c3518f",
  "displayName": "Account Found",
  "form": {
  
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "identification_status",
      "value": "Pass"
    }, {
      "parameter": "customer_type",
      "value": "Existing"
    }, {
      "parameter": "customer_data",
      "value": "$sys.func.FILTER(\"$session.params.customer_id_search_response\",$sys.func.CONCATENATE(\"$..billing_accounts[?(@.billing_account_number == '\",$sys.func.TO_TEXT($session.params.billing_account_number),\"')]\"))"
    }, {
      "parameter": "billing_account_info_list",
      "value": "$sys.func.TO_OBJECT(   $sys.func.TO_TEXT($session.params.customer_data[0]) )"
