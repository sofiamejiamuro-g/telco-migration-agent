    "name": "ec620bf7-e49f-41be-8f39-6ba778f3e638"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "Désolé, nous pouvons seulement accepter des paiements jusqu'à 10,000 $" ]
        },
        "languageCode": "fr-ca"
      }, {
        "text": {
          "text": [ "We can only take payments between $1 and $10,000" ]
        },
        "languageCode": "en"
      } ],
      "setParameterActions": [ {
        "parameter": "clp_bad_amount",
        "value": 0
      } ]
    },
    "targetFlow": "bell_Feedback",
    "name": "9eb8d4ab-fcd9-44b6-b080-ce1bb95fbf69"
  } ]
