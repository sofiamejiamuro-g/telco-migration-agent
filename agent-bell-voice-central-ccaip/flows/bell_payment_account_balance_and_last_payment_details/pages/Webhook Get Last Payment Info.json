{
  "name": "8eefe70f-c964-4e68-a8ed-06e98873ab6c",
  "displayName": "Webhook Get Last Payment Info",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "/v1/ibm_mw/nm1_get#last-payment-info",
    "tag": "last-payment-info",
    "setParameterActions": [ {
      "parameter": "billing_account",
      "value": "$session.params.billing_account"
    }, {
      "parameter": "ibm_application_id ",
      "value": "$sys.func.IF(\"$session.params.intake_routing_lookup_response.va_ibm_id = null\", BCE_Entry, $session.params.intake_routing_lookup_response.va_ibm_id)"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "last_payment_date",
        "value": "$session.params.nm1_get_last_payment_info_response.lastPaymentDate"
      }, {
        "parameter": "last_payment_amount",
        "value": "$session.params.nm1_get_last_payment_info_response.lastPaymentAmount"
      }, {
        "parameter": "formatDate",
        "value": "$sys.func.MID($session.params.last_payment_date, 1, 10)"
      }, {
        "parameter": "date",
        "value": "$sys.func.MID($session.params.formatDate, 6, 5)"
      }, {
        "parameter": "md_list",
        "value": "$sys.func.SPLIT($session.params.date, \"-\")"
      }, {
        "parameter": "month",
        "value": "$session.params.md_list[0]"
      }, {
        "parameter": "day",
        "value": "$session.params.md_list[1]"
      }, {
        "parameter": "fr_date",
        "value": "$sys.func.CONCATENATE($session.params.day, \"-\", $session.params.month)"
      }, {
        "parameter": "error_return_code",
        "value": "$session.params.nm1_get_last_payment_info_response.returnCode"
      } ]
    },
    "name": "2ca97952-8194-4910-b08a-34c8262b2dd0"
  }, {
    "condition": "$session.params.webhook_success = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Check Balance",
    "name": "80fa1d9b-fa2b-46df-a1da-df40678adbfa"
  }, {
    "condition": "$session.params.webhook_success = false AND ($session.params.error_return_code = \"0\" OR $session.params.error_return_code = 0)",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "last_payment_amount",
        "value": null
      }, {
        "parameter": "last_payment_date",
        "value": null
      } ]
    },
    "targetPage": "Check Balance",
    "name": "72badb0d-9d9e-40ec-8210-659a21247ee3"
  }, {
    "condition": "$session.params.webhook_success = false",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook Failure Balance Details",
    "name": "13aed2ff-2e53-45d5-bd82-6eab88505001"
  }, {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "hardstop",
