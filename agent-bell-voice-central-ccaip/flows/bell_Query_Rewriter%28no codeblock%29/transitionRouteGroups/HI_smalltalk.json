    "intent": "small_talk.hangup_apology",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "I’m sorry to hear that your call dropped. Unfortunately I don’t have details about your last communication. Can you please give me context about the reason of that call and I’ll do my best to help you?" ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Je suis désolé d’apprendre que votre appel a été interrompu. Malheureusement, je n’ai pas de détails sur cette communication. Pourriez-vous me préciser la raison de cet appel et je ferai de mon mieux pour vous aider?" ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "route",
        "value": "small_talk.hangup_apology"
      }, {
        "parameter": "utterance",
        "value": "$request.user-utterance"
      } ]
    },
    "name": "3819d3f4-d1cc-46bc-9d0b-23d850cfa634",
    "targetPlaybook": "bell_NLU_Query_Rewriter"
  }, {
