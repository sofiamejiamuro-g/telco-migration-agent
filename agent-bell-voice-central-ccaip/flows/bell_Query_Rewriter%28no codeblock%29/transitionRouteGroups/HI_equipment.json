  "transitionRoutes": [ {
    "intent": "equipment_cancel_order",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "route",
        "value": "equipment_cancel_order"
      }, {
        "parameter": "utterance",
        "value": "$request.user-utterance"
      }, {
        "parameter": "active_services",
        "value": "$sys.func.FILTER(\"$session.params. billing_account_info_list\",\"$[*].services[*].service_type\")"
      }, {
        "parameter": "unique_services",
        "value": "$sys.func.UNIQUE($session.params.active_services)"
      }, {
        "parameter": "number_of_services",
        "value": "$sys.func.COUNT($session.params.unique_services)"
      }, {
        "parameter": "lob",
        "value": "$sys.func.IF($session.params.number_of_services=1, $session.params.number_of_services[0], null)"
      }, {
        "parameter": "device_type",
