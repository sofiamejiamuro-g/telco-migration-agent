            "message": {
              "text": {
                "text": [ "The card number isn't complete. You can try using your phone's keypad to enter it. Can you give it another try?" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "Le numéro de carte est incomplet. Vous pouvez le saisir à l’aide du clavier de votre téléphone. Pouvez-vous réessayer?" ]
