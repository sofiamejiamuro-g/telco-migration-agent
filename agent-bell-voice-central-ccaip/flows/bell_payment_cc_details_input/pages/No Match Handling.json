              "languageCode": "fr-ca"
            }
          } ]
        }, {
          "caseContent": [ {
            "message": {
              "text": {
                "text": [ "Sorry, but the card number entered is not valid. Could you please double-check the number and try again?" ]
              },
              "languageCode": "en"
            }
          }, {
            "message": {
              "text": {
                "text": [ "Désolée, mais le numéro de carte entré n’est pas valide. Pourriez-vous vérifier le numéro et réessayer?" ]
              },
              "languageCode": "fr-ca"
            }
          } ]
        } ]
      } ]
    },
    "targetPage": "Prompt CC Number",
    "name": "a1b75887-6406-4dff-a82d-8729aee09b13"
  }, {
    "condition": "$session.params.card_len_check_counter \u003e= 2",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "To keep things secure, we ask that you call back later or you can also easily complete this step using the MyBell app." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Pour assurer la sécurité, nous vous demandons de réessayer plus tard. Vous pouvez également effectuer un paiement à tout moment à l’aide de l’Appli MonBell." ]
