  "transitionRoutes": [ {
    "condition": "$session.params.expiry_month = \"0\" OR $session.params.expiry_month = 0",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "expiry_date",
        "value": null
      }, {
        "parameter": "n_incorrect_date",
        "value": "$sys.func.ADD($session.params.n_incorrect_date,1)"
      } ],
      "conditionalCases": [ {
        "cases": [ {
          "condition": "$session.params.n_incorrect_date \u003c 2",
          "caseContent": [ {
            "message": {
              "text": {
                "text": [ "Cela ne semble pas exact. Pourriez-vous répéter la date d'expiration?" ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "That doesn't seem right. What's the expiry date again?" ]
              },
              "languageCode": "en"
            }
          } ]
        }, {
          "caseContent": [ {
            "message": {
              "text": {
                "text": [ "Pour assurer la sécurité, nous vous demandons d'essayer de nouveau plus tard. Vous pouvez également effectuer un palement à tout moment à l'aide de l'appli Mon Compte." ]
              },
              "languageCode": "fr-ca"
            }
          }, {
            "message": {
              "text": {
                "text": [ "To keep things secure, we ask that you please try again later. You can also make a payment at any point using the My Account app." ]
              },
              "languageCode": "en"
            }
          } ]
