{
  "name": "d3438a0a-66b0-426a-9597-5e7bcb9008cf",
  "displayName": "Prompt CC Number",
  "form": {
    "parameters": [ {
      "displayName": "card_number",
      "required": true,
      "entityType": "@sys.number-sequence",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.repeat_flag = 0 AND $session.params.card_len_check_counter = 0 AND $session.params.no_match_counter = 0 AND $session.params.mod_counter = 0 AND $session.params.faq_flag = 0 AND $session.params.wrong_cc_number_counter = 0",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "Now I'm going to need your credit or Visa debit card details. I'll be reading the card details back to you so please ensure you're in a private area. When you're ready, please enter your card number using the keypad." ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "J'ai maintenant besoin de vos informations de carte de crédit ou de débit Visa. Je vous les lirai ; veuillez donc vous trouver dans un espace privé. Lorsque vous serez prêt, saisissez votre numéro de carte à l'aide du clavier." ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "event": "sys.no-match-1",
          "triggerFulfillment": {
            "messages": [ {
              "text": {
                "text": [ "I didn't get a number from you. Could you please enter your card number when you're ready?" ]
              },
              "languageCode": "en"
            }, {
              "text": {
                "text": [ "VA: Je n’ai pas reçu de numéro de votre part. Pourriez-vous entrer votre numéro de carte lorsque vous serez prêt?" ]
              },
              "languageCode": "fr-ca"
            } ]
          },
          "name": "c6f7a79f-156d-479c-813f-330372903ecb"
        }, {
