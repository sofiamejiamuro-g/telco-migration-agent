            "messages": [ {
              "text": {
                "text": [ "Since I didn't get a number from you, I won't be able to proceed with this step. You can call back later or you can also easily complete this step using the MyBell app." ]
              },
              "languageCode": "en"
            }, {
              "text": {
                "text": [ "Puisque je n’ai pas reçu de numéro de votre part, je ne pourrai pas traiter votre paiement. Vous pouvez rappeler plus tard ou vous pouvez facilement effectuer un paiement à l’aide de l’appli MonBell." ]
