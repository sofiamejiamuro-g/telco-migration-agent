        } ]
      },
      "redact": true
    } ]
  },
  "entryFulfillment": {
  
  },
  "transitionRoutes": [ {
    "intent": "context.user_makes_mistake",
    "triggerFulfillment": {
      "messages": [ {
        "text": {
          "text": [ "No worries, please say or re-enter your number when ready." ]
        },
        "languageCode": "en"
      }, {
        "text": {
          "text": [ "Pas de souci; veuillez dire ou saisir à nouveau votre numéro lorsque vous êtes prêt" ]
        },
        "languageCode": "fr-ca"
      } ],
      "setParameterActions": [ {
        "parameter": "global_error_counter",
        "value": "$sys.func.ADD(1, $session.params.global_error_counter)"
      }, {
        "parameter": "Mistake_Counter",
        "value": "$sys.func.ADD(1, $session.params.Mistake_Counter)"
      } ]
    },
    "name": "86384f69-b91b-41f7-9230-379889a16500"
  }, {
    "condition": "$page.params.status = \"FINAL\" AND $session.params.card_number != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "faq_flag",
        "value": 0
      }, {
        "parameter": "repeat_flag",
        "value": 0
      }, {
        "parameter": "check_credit_card_number",
        "value": "$sys.func.IS_CREDIT_CARD_NUMBER($sys.func.TO_TEXT($session.params.card_number))"
      }, {
        "parameter": "len_credit_card_number",
        "value": "$sys.func.LEN($sys.func.TO_TEXT($session.params.card_number))"
      }, {
        "parameter": "amex_check_digits",
        "value": "$sys.func.MID($sys.func.TO_TEXT($session.params.card_number),1,2)"
      } ]
    },
    "targetPage": "Credit Card Length Validation",
    "name": "39242ee0-f296-480c-b0f8-96a961eeed6d"
  } ]
}
