          "triggerFulfillment": {
            "messages": [ {
              "text": {
                "text": [ "I didn't get a number from you. Could you please enter your card number when you're ready?" ]
              },
              "languageCode": "en"
            }, {
              "text": {
                "text": [ "Je n’ai pas obtenu de numéro de votre part. Pourriez-vous entrer votre numéro de carte lorsque vous êtes prêt?" ]
              },
              "languageCode": "fr-ca"
            } ]
          },
