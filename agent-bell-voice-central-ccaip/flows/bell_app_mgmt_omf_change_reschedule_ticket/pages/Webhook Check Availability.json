{
  "name": "fe47bb68-e444-46f5-a22f-7c911f7aae98",
  "displayName": "Webhook Check Availability",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/ticket_management/omf/calendar#availability",
    "tag": "availability",
    "setParameterActions": [ {
      "parameter": "startDate",
      "value": "$request.generative.start_date_utc"
    }, {
      "parameter": "endDate",
      "value": "$request.generative.end_date_utc"
    }, {
      "parameter": "accountNumber",
      "value": "$session.params.billing_account_number"
    }, {
      "parameter": "intervals",
      "value": [ "AllDay" ]
    }, {
      "parameter": "today_date",
      "value": "$request.generative.start_date_utc"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "consistent_calendars",
        "value": "$session.params.omf_calendaring_response.consistent_calendars"
      }, {
        "parameter": "calendarInformationList_1",
        "value": "$sys.func.COUNT($session.params.omf_calendaring_response.installationDetailList.installationDetail)"
      }, {
        "parameter": "calendarInformationList",
        "value": "$sys.func.TO_NUMBER($session.params.calendarInformationList_1)"
      }, {
        "parameter": "list_of_date_offered",
        "value": "$session.params.calendar_data.calendarInformationList.CalendarInformation[0].calendarAppointmentData.dateOfferedList.dateOffered"
      }, {
        "parameter": "date_available",
        "value": "$session.params.omf_calendaring_response.calendarInformationList.CalendarInformation"
      }, {
        "parameter": "calender_availibility_response",
        "value": "$session.params.omf_calendaring_response"
      } ]
    },
    "name": "76be3d98-d2a6-4db5-bdc3-e5e59af71078"
  }, {
    "condition": "$session.params.webhook_success = true",
    "triggerFulfillment": {
    
    },
    "targetPage": "Check Calendar Consistency 1",
    "name": "feeee021-9e31-4615-8909-b282dbbf8b86"
  }, {
    "condition": "$session.params.webhook_success = false",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook Failure - OMF",
    "name": "e953fb51-9173-4526-b962-ed7e7f53a2c2"
  }, {
    "condition": "true",
    "triggerFulfillment": {
    
    },
