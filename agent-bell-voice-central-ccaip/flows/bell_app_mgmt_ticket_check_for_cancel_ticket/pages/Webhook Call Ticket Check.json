      }, {
        "parameter": "acut_context_raw",
        "value": "$session.params.acut_retrieve_response.acutContext"
      }, {
        "parameter": "acut_context",
        "value": "$sys.func.TO_OBJECT($session.params.acut_context_raw)"
      }, {
        "parameter": "appointment_start_date",
        "value": "$session.params.acut_context.appointments.latestAppointment.appointmentStartDate"
