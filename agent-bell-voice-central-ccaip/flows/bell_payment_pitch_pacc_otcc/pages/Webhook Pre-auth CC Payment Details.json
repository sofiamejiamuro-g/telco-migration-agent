{
  "name": "ae1aa566-568f-48db-819b-a6ca35e84280",
  "displayName": "Webhook Pre-auth CC Payment Details",
  "form": {
  
  },
  "entryFulfillment": {
    "webhook": "v1/pre-auth-payment#cc-payment-details",
    "tag": "cc-payment-details",
    "setParameterActions": [ {
      "parameter": "transaction_id",
      "value": "$session.params.transaction_id"
    }, {
      "parameter": "cc_token",
      "value": "$session.params.cc_token"
    }, {
      "parameter": "expiry_year",
      "value": "$sys.func.MID($sys.func.TO_TEXT($session.params.expiry_date),3,2)",
      "redact": true
    }, {
      "parameter": "expiry_month",
      "value": "$sys.func.MID($sys.func.TO_TEXT($session.params.expiry_date),1,2)",
      "redact": true
    }, {
      "parameter": "security_code",
      "value": "$session.params.cvv_number",
      "redact": true
    }, {
      "parameter": "webhook_success",
      "value": null
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = True OR $session.params.webhook_success = true",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "route",
        "value": "payment_make_payment"
      }, {
        "parameter": "from_pacc_otcc",
        "value": "true"
      } ]
    },
    "targetFlow": "bell_payment_process_pacc_registration",
    "name": "5d1b0ccb-fe2b-400f-ab9b-cff0a3b67119"
  }, {
    "condition": "$session.params.webhook_success = False OR $session.params.webhook_success = false",
