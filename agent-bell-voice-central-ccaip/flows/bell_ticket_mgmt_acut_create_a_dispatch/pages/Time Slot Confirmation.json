{
  "name": "c6de6dc6-a5ba-4e99-8966-2284e07488bb",
  "displayName": "Time Slot Confirmation",
  "form": {
    "parameters": [ {
      "displayName": "selected_timeslot",
      "required": true,
      "entityType": "@sys.time-period",
      "fillBehavior": {
        "initialPromptFulfillment": {
          "conditionalCases": [ {
            "cases": [ {
              "condition": "$session.params.slot_count \u003e \"1\"",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "We have time slots from $session.params.available_slots_string_2. Which one works best for you?" ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "Nous avons des plages horaires disponibles de $session.params.available_slots_string_fr_2. Laquelle vous convient le mieux?" ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            }, {
              "condition": "$session.params.slot_details.slot_count = \"1\"",
              "caseContent": [ {
                "message": {
                  "text": {
                    "text": [ "We have time slots from $session.params.available_slots_string_2. Does that work for you?" ]
                  },
                  "languageCode": "en"
                }
              }, {
                "message": {
                  "text": {
                    "text": [ "Nous avons des plages horaires disponibles de $session.params.available_slots_string_fr_2. Est-ce que cela vous convient?" ]
                  },
                  "languageCode": "fr-ca"
                }
              } ]
            } ]
          } ]
        },
        "repromptEventHandlers": [ {
          "targetPage": "Local Error handling + Time Slot confirmation",
          "event": "sys.no-input-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_noinput_counter",
              "value": "$sys.func.ADD($session.params.local_noinput_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_input"
            } ]
          },
          "name": "a1b5a1ca-93ea-457e-89fe-482113a73a1e"
        }, {
          "targetPage": "Local Error handling + Time Slot confirmation",
          "event": "sys.no-match-1",
          "triggerFulfillment": {
            "setParameterActions": [ {
              "parameter": "global_error_counter",
              "value": "$sys.func.ADD($session.params.global_error_counter,1)"
            }, {
              "parameter": "local_nomatch_counter",
              "value": "$sys.func.ADD($session.params.local_nomatch_counter,1)"
            }, {
              "parameter": "local_trigger",
              "value": "no_match"
            } ]
          },
          "name": "af82e691-8de6-4ec7-aec5-03625f996957"
        } ]
      }
    } ]
  },
  "entryFulfillment": {
    "setParameterActions": [ {
      "parameter": "slot_details_raw",
      "value": "$request.generative.slot_details"
    }, {
      "parameter": "slot_details",
      "value": "$sys.func.TO_OBJECT($session.params.slot_details_raw)"
    }, {
      "parameter": "available_slots_string",
      "value": "$session.params.slot_details.available_slots_string"
    }, {
      "parameter": "available_slots_string_fr",
      "value": "$session.params.slot_details.available_slots_string_fr"
    }, {
      "parameter": "available_slots_string_2",
      "value": "$session.params.slot_details.available_slots_string_2"
    }, {
      "parameter": "available_slots_string_fr_2",
      "value": "$session.params.slot_details.available_slots_string_fr_2"
    }, {
      "parameter": "slot_count",
      "value": "$session.params.slot_details.slot_count"
    } ]
  },
  "transitionRoutes": [ {
    "intent": "context.confirm_yes",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "time_input",
        "value": "$session.params.available_slots_string"
      } ],
      "generators": [ {
        "generator": "projects/gcp-it-npe-auth-va-dlgflw/locations/us-central1/agents/8fb0c680-c945-4186-b6ab-47b4baeba61d/generators/2fa2bf9e-45ac-42ee-9e0e-ba8e0f9fb594",
        "inputParameters": [ {
          "key": "time_input",
          "value": "$session.params.time_input"
        } ],
        "outputParameter": "$request.generative.time_pair_string"
      } ]
    },
    "targetPage": "Time Slot Object Extraction",
    "name": "ecd85b76-4b4c-4ec0-bcac-5c38ddf72260"
  }, {
    "intent": "context.confirm_no",
    "triggerFulfillment": {
    
    },
    "targetPage": "Webhook - WFAS Cancel",
    "name": "6bb3fe37-6880-4199-9b4d-d323e4ede38e"
  }, {
    "condition": "$session.params.selected_timeslot != null",
    "triggerFulfillment": {
      "setParameterActions": [ {
        "parameter": "time_input",
        "value": "$session.params.selected_timeslot"
      } ],
      "generators": [ {
        "generator": "projects/gcp-it-npe-auth-va-dlgflw/locations/us-central1/agents/8fb0c680-c945-4186-b6ab-47b4baeba61d/generators/2fa2bf9e-45ac-42ee-9e0e-ba8e0f9fb594",
        "inputParameters": [ {
          "key": "time_input",
          "value": "$session.params.time_input"
        } ],
        "outputParameter": "$request.generative.time_pair_string"
      } ]
    },
    "targetPage": "Time Slot Object Extraction",
    "name": "b7f74972-7e46-4659-a741-8c24f3e6999c"
  } ]
}
