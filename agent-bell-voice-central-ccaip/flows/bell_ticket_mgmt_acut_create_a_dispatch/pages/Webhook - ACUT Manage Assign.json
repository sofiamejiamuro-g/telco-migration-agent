  },
  "entryFulfillment": {
    "webhook": "/v1/ticket_management/acut/manage#assign",
    "tag": "assign",
    "setParameterActions": [ {
      "parameter": "ticket_number",
      "value": "$session.params.ticket_number"
    }, {
      "parameter": "menu_type",
      "value": "$session.params.menu_type"
    }, {
      "parameter": "dispatch_type",
      "value": "$session.params.dispatch_type"
    }, {
      "parameter": "ticket_number_ref",
      "value": "$sys.func.CONCATENATE(\"REF\", $sys.func.TO_TEXT($session.params.ticket_number))"
    } ]
  },
  "transitionRoutes": [ {
    "condition": "$session.params.webhook_success = true",
